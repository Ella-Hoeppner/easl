(defn uni->bi [x: f32]: f32
  (-> x (* 2.) (- 1.)))

(defn uni->bi [x: vec2f]: vec2f
  (vec2f (uni->bi x.x) (uni->bi x.y)))

(defn bi->uni [x: f32]: f32
  (-> x (+ 1.) (* 0.5)))

(defn bi->uni [x: vec2f]: vec2f
  (vec2f (bi->uni x.x) (bi->uni x.y)))

(defn (get-ring-buffer T)
      [@ref buffer: [T]
       start-index: u32
       index: u32]: T
      (-> index
          (+ start-index)
          (% (length buffer))
          buffer))

(defn (push-ring-buffer T)
      [@ref @var buffer: [T]
       @ref @var start-index: u32
       value: T]
      (= (buffer start-index) value)
      (= start-index
         (-> start-index
             (+ 1)
             (% (length buffer)))))

(var envelope-history: [f32])

(var envelope-history-start-index: u32)

(struct ADSRParams
  attack: f32
  decay: f32
  sustain: f32
  release: f32)

(enum ADSRPhase
  Attack
  Decay
  Sustain
  Neutral)

(struct ADSRState
  level: f32
  phase: ADSRPhase
  gate-was-on: bool)

(defn new []: ADSRState
  (ADSRState 0. Neutral false))

(defn update-adsr [@var state: ADSRState
                   params: ADSRParams
                   gate: bool
                   dt: f32]: ADSRState
  (let [old-phase state.phase]
    (when (and gate (not state.gate-was-on))
      (= state.phase Attack))
    (match state.phase
      Attack (let [new-level (+ state.level
                                (/ dt params.attack))]
               (= state.level
                  (min 1. new-level))
               (when (>= new-level 1.)
                 (= state.phase Decay)))
      Decay (let [new-level (- state.level
                               (/ dt params.decay))]
              (= state.level
                 (max params.sustain new-level))
              (when (<= new-level params.sustain)
                (= state.phase
                   (if gate
                     Sustain
                     Neutral))))
      Sustain (if gate
                (= state.level params.sustain)
                (= state.phase Neutral))
      Neutral (if gate
                (= state.phase Attack)
                (= state.level
                   (max 0.
                        (- state.level
                           (/ dt params.release)))))))
  (= state.gate-was-on gate)
  state)

(struct Voice
  note: u32
  down: bool
  adsr-state: ADSRState)

(var voices: [Voice])

(defn (filter T)
      [arr: [T]
       f: (Fn [T] bool)]: [T]
      (let [@var new-arr ~[]]
        (for [i (array-length arr)]
          (when (f (arr i))
            (= new-arr
               (push new-arr (arr i)))))
        new-arr))

(defn sympow [x: f32
              p: f32]: f32
  (-> x abs (pow p) (* (sign x))))

(defn sigmoid [x: f32]: f32
  (-> x - exp (+ 1) /))

(struct (MidiVoice S)
  note: u32
  down: bool
  state: S)

(struct (StateAndSample T)
  state: T
  sample: f32)

(defn (midi-polyphony S)
      [initializer: (Fn [MidiNote] S)
       updater: (Fn [S u32 (Option MidiNote)]
             (Option (StateAndSample S)))]: (Fn [] f32)
      (let [@var active-voices: [(MidiVoice S)] ~[]]
        (fn []
            (let [notes (down-midi-notes)]
              (for [i
                    (array-length active-voices)]
                (= (.down (active-voices i))
                   false))
              (for [i (array-length notes)]
                (let [note (notes i)
                      @var note-existed false]
                  (for [i2
                        (array-length active-voices)]
                    (let [voice (active-voices i2)]
                      (when (== note.note voice.note)
                        (= (.down (active-voices i2))
                           true)
                        (= note-existed true))))
                  (when (not note-existed)
                    (let [old-voices active-voices
                          old-voice-count (array-length active-voices)]
                      (= active-voices
                         (push active-voices
                               (MidiVoice note.note
                                          true
                                          (initializer note))))))))
              (let [@var indeces-to-remove ~[]
                    @var sum 0.]
                (for [i
                      (array-length active-voices)]
                  (match (updater (.state (active-voices i))
                                  (.note (active-voices i))
                                  None
                                  #_(get-midi-note (.note (active-voices i))))
                    (Some state-and-sample) (do (= (.state (active-voices i))
                                                   state-and-sample.state)
                                                (+= sum state-and-sample.sample))
                    None (= indeces-to-remove
                            (push indeces-to-remove i))))
                (for [i (length indeces-to-remove)]
                  (= active-voices
                     (remove active-voices
                             (indeces-to-remove (- (length indeces-to-remove)
                                                   (+ i 1))))))
                sum)
              #_(= active-voices
                   (filter active-voices
                           (fn [voice]
                               (or (.down voice)
                                   (> (.level (.adsr-state voice))
                                      0.)))))
              #_(let [@var sum 0.]
                  (for [i (length active-voices)]
                    (let [voice (active-voices i)]
                      (+= sum
                          (* voice.adsr-state.level
                             (sympow (cos (* (-> voice.note
                                                 f32
                                                 (- 69)
                                                 (/ 12)
                                                 (pow 2 <>)
                                                 (* 440))
                                             (audio-time)))
                                     (* 0.6
                                        (pow 1.175
                                             (cos (* (audio-time) 6.283 9)))))))))
                  (sigmoid sum))))))

(defn (is-some? T)
      [o: (Option T)]: bool
      (match o
        (Some v) true
        _ false))

(defn (then T)
      [b: bool
       f: (Fn [] T)]: (Option T)
      (if b
        (Some (f))
        None))

@cpu
(defn main []
  (= voices ~[])
  (start-audio (let [params (ADSRParams 0.01 0.1 0.2 0.5)]
                 (midi-polyphony (fn [note] (new))
                                 (fn [state idx note]
                                     (let [new-state (update-adsr state
                                                                  params
                                                                  (is-some? note)
                                                                  (/ (sample-rate)))]
                                       (then (or (> new-state.level 0.)
                                                 (is-some? note))
                                             (fn []
                                                 (StateAndSample new-state
                                                                 (* new-state.level
                                                                    (sympow (cos (* (-> idx
                                                                                        f32
                                                                                        (- 69)
                                                                                        (/ 12)
                                                                                        (pow 2 <>)
                                                                                        (* 440))
                                                                                    (audio-time)))
                                                                            (* 0.6
                                                                               (pow 1.175
                                                                                    (cos (* (audio-time) 6.283 9))))))))))))))
  #_(start-audio (let [params (ADSRParams 0.01 0.1 0.2 0.5)]
                   (fn []
                       (let [notes (down-midi-notes)]
                         (for [i (array-length voices)]
                           (= (.down (voices i)) false))
                         (for [i (array-length notes)]
                           (let [note (notes i)
                                 @var note-existed false]
                             (for [i2 (array-length voices)]
                               (let [voice (voices i2)]
                                 (when (== note.note voice.note)
                                   (= (.down (voices i2)) true)
                                   (= note-existed true))))
                             (when (not note-existed)
                               (let [old-voices voices
                                     old-voice-count (array-length voices)]
                                 (= voices
                                    (push voices
                                          (Voice note.note true (new))))))))
                         (for [i (array-length voices)]
                           (= (.adsr-state (voices i))
                              (update-adsr (.adsr-state (voices i))
                                           params
                                           (.down (voices i))
                                           (/ (sample-rate)))))
                         (= voices
                            (filter voices
                                    (fn [voice]
                                        (or (.down voice)
                                            (> (.level (.adsr-state voice))
                                               0.)))))
                         (let [@var sum 0.]
                           (for [i (length voices)]
                             (let [voice (voices i)]
                               (+= sum
                                   (* voice.adsr-state.level
                                      (sympow (cos (* (-> voice.note
                                                          f32
                                                          (- 69)
                                                          (/ 12)
                                                          (pow 2 <>)
                                                          (* 440))
                                                      (audio-time)))
                                              (* 0.6
                                                 (pow 1.175
                                                      (cos (* (audio-time) 6.283 9)))))))))
                           (sigmoid sum))))))
  (spawn-window (fn []
                    (print (down-midi-notes))
                    (print voices)
                    (dispatch-render-shaders (fn []
                                                 (vec4f (match (vertex-index)
                                                          0 (vec2f -1.)
                                                          1 (vec2f 3. -1.)
                                                          _ (vec2f -1. 3.))
                                                        0.
                                                        1.))
                                             (fn []
                                                 (vec4f (vec3f (* (f32 (array-length (down-midi-notes)))
                                                                  0.1))
                                                        1.))
                                             3))))

