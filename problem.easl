(def TAU: f32
     6.28318530718)

(defn slider [x: f32]: f32
  x)

(defn cis [x: f32]: vec2f
  (vec2f (cos x) (sin x)))

(var rand-state: f32)

(defn set-rand-seed [x: f32]: ()
  (= rand-state x))

(defn hash [@var x: u32]: u32
  (+= x (<< x 10))
  (= x (^ x (>> x 6)))
  (+= x (<< x 3))
  (= x (^ x (>> x 11)))
  (+= x (<< x 15))
  x)

(defn rand []: f32
  ; based on https://amindforeverprogramming.blogspot.com/2013/07/random-floats-in-glsl-330.html

  (= rand-state
     (+ rand-state 0.025))
  (let [mantissa-mask 8388607u
        one 1065353216u]
    (-> rand-state
        (bitcast <>): u32
        hash
        (& mantissa-mask)
        (| one)
        (bitcast <>): f32
        (- 1.))))

(defn rand [maximum: f32]: f32
  (* maximum (rand)))

(defn rand [minimum: f32
            maximum: f32]: f32
  (+ minimum
     (* (- maximum minimum) (rand))))

(defn rand [maximum: u32]: u32
  (u32 (* (f32 maximum) (rand))))

(defn rand-dir []: vec2f
  (cis (* (rand) TAU)))

(defn rand-exp []: f32
  (- (log (rand))))

(defn rand-norm []: vec2f
  (* (sqrt (* -2. (log (rand))))
     (cis (* TAU (rand)))))

(struct BiquadParameters
  cutoff: f32
  ; in Hz

  q: f32
  lp: f32
  ; the three numerator-space mix knobs

  bp: f32
  hp: f32)

(defn low-pass [cutoff: f32
                q: f32]: BiquadParameters
  (BiquadParameters cutoff q 1. 0. 0.))

(defn low-pass [cutoff: f32]: BiquadParameters
  (low-pass cutoff 0.7071068))

(defn high-pass [cutoff: f32
                 q: f32]: BiquadParameters
  (BiquadParameters cutoff q 0. 0. 1.))

(defn high-pass [cutoff: f32]: BiquadParameters
  (high-pass cutoff 0.7071068))

(defn band-pass [center: f32
                 q: f32]: BiquadParameters
  (BiquadParameters center q 0. 1. 0.))

(defn notch [center: f32
             q: f32]: BiquadParameters
  (BiquadParameters center q 1. 0. 1.))

(defn all-pass [center: f32
                q: f32]: BiquadParameters
  (BiquadParameters center q 1. -1. 1.))

(struct BiquadState
  s1: f32
  s2: f32)

(defn update-biquad [signal: f32
                     @var @ref state: BiquadState
                     params: BiquadParameters]: f32
  (let [w0 (* TAU
              params.cutoff
              (/ (sample-rate)))
        cs (cos w0)
        alpha (/ (sin w0) (* 2. params.q))
        a0 (+ 1. alpha)
        a1 (/ (* -2. cs) a0)
        a2 (/ (- 1. alpha) a0)
        lp-shape (* 0.5 (- 1. cs))
        ; (1-c)/2: zeros at Nyquist

        hp-shape (* 0.5 (+ 1. cs))
        ; (1+c)/2: zeros at DC

        b0 (/ (+ (* params.lp lp-shape)
                 (* params.bp alpha)
                 (* params.hp hp-shape))
              a0)
        b1 (/ (- (* 2. params.lp lp-shape)
                 (* 2. params.hp hp-shape))
              a0)
        b2 (/ (- (+ (* params.lp lp-shape)
                    (* params.hp hp-shape))
                 (* params.bp alpha))
              a0)
        y (+ (* b0 signal) state.s1)]
    (= state.s1
       (- (+ (* b1 signal) state.s2)
          (* a1 y)))
    (= state.s2
       (- (* b2 signal) (* a2 y)))
    y))

(defn update-biquad-svf [signal: f32
                         @var @ref state: BiquadState
                         params: BiquadParameters]: f32
  (let [g (tan (* 0.5
                  TAU
                  params.cutoff
                  (/ (sample-rate))))
        k (/ 1. params.q)
        a1 (/ 1. (+ 1. (* g (+ g k))))
        a2 (* g a1)
        a3 (* g a2)
        v3 (- signal state.s2)
        v1 (+ (* a1 state.s1) (* a2 v3))
        v2 (+ state.s2
              (* a2 state.s1)
              (* a3 v3))
        high (- signal (+ (* k v1) v2))]
    (= state.s1
       (- (* 2. v1) state.s1))
    (= state.s2
       (- (* 2. v2) state.s2))
    (+ (* params.lp v2)
       (* params.bp v1)
       (* params.hp high))))

(defn repeating-pulse-envelope [on-duration: f32
                                repeat-duration: f32]: (Fn [] f32)
  (let [@var phase 0.]
    (fn []
        (= phase
           (-> phase
               (+ (/ (sample-rate)))
               (% repeat-duration)))
        (if (< phase on-duration)
          1.
          0.))))

(defn amplitude-modulate [s1: (Fn [] f32)
                          s2: (Fn [] f32)]: (Fn [] f32)
  (fn [] (* (s1) (s2))))

(defn osc [t: f32]: f32
  (-> t (* TAU) cos))

(defn ramp [t: f32]: f32
  (-> t
      (+ (ceil (abs t)))
      (% 1.)
      uni->bi))

(defn create-osc [freq: f32]: (Fn [] f32)
  (let [@var phase 0.]
    (fn []
        (= phase
           (-> phase
               (+ (/ (sample-rate)))
               (% 1.)))
        (% (* phase freq) 1.))))

(defn echo [signal: (Fn [] f32)
            delay-time: f32
            feedback: f32
            wet: f32]: (Fn [] f32)
  (let [delay-length (u32 (* (sample-rate) delay-time))
        @var delay-buffer (zeroed-array delay-length): [f32]
        @var delay-index 0u]
    (fn []
        (let [signal-value (signal)
              delayed (delay-buffer delay-index)]
          (= (delay-buffer delay-index)
             (+ signal-value
                (* feedback delayed)))
          (= delay-index
             (-> delay-index
                 (+ 1u)
                 (% delay-length)))
          (+ signal-value (* wet delayed))))))

(defn with-integrated-phase [f: (Fn [f32] f32)
                             cycle-length: f32]: (Fn [] f32)
  (let [@var phase 0.]
    (fn []
        (= phase
           (-> phase
               (+ (/ (sample-rate)))
               (% cycle-length)))
        (f phase))))

(defn with-integrated-phase-and-counter [f: (Fn [f32 u32] f32)
                                         cycle-length: f32]: (Fn [] f32)
  (let [@var phase 0.
        @var counter 0u]
    (fn []
        (= phase
           (-> phase (+ (/ (sample-rate)))))
        (when (> phase cycle-length)
          (= phase (% phase cycle-length))
          (+= counter 1u))
        (f phase counter))))

@associative
(defn + [a: (Fn [] f32)
         b: (Fn [] f32)]: (Fn [] f32)
  (fn [] (+ (a) (b))))

(defn * [a: (Fn [] f32)
         b: (Fn [] f32)]: (Fn [] f32)
  (fn [] (* (a) (b))))

(defn * [s: (Fn [] f32)
         factor: f32]: (Fn [] f32)
  (fn [] (* (s) factor)))

(defn (split-index C: u32)
      [@var i: u32
       splits: [C: u32]]: [C: u32]
      (let [@var out (zeroed-array)]
        (for [idx (array-length splits)]
          (let [split (splits idx)]
            (= (out idx) (% i split))
            (/= i split)))
        out))

(defn filtered [f: (Fn [] f32)
                params: BiquadParameters]: (Fn [] f32)
  (let [@var state (BiquadState 0. 0.)]
    (fn []
        (update-biquad-svf (f) state params))))

(defn apply [signal: (Fn [] f32)
             effect: (Fn [f32] f32)]: (Fn [] f32)
  (fn [] (effect (signal))))

(defn sigmoid [x: f32]: f32
  (-> x - exp (+ 1) /))

(defn sigmoid [signal: (Fn [] f32)]: (Fn [] f32)
  (fn [] (sigmoid (signal))))

(defn distort-sigmoid [signal: (Fn [] f32)
                       factor: f32]: (Fn [] f32)
  (fn []
      (sigmoid (* factor (signal)))))

(defn sympow [x: f32
              p: f32]: f32
  (-> x abs (pow p) (* (sign x))))

(defn sympow [x: f32
              p: f32
              wet: f32]: f32
  (-> x
      abs
      (pow p)
      (* (sign x))
      (mix x <> wet)))

(defn distort-sympow [signal: (Fn [] f32)
                      power: f32]: (Fn [] f32)
  (fn [] (sympow (signal) power)))

(defn (map T
           U
           C: u32)
      [f: (Fn [T] U)
       arr: [C: T]]: [C: U]
      (let [@var out (zeroed-array)]
        (for [i (array-length arr)]
          (= (out i) (f (arr i))))
        out))

(struct Grain
  start-pos: f32
  len: f32
  speed: f32
  pos: f32)

(defn new-grain [start-pos: f32
                 len: f32
                 speed: f32]: Grain
  (Grain start-pos len speed start-pos))

(enum (Option T)
  (Some T)
  None)

(defn (unwrap-or T)
      [o: (Option T)
       default: T]: T
      (match o
        (Some v) v
        None default))

(defn (unwrap-or-else T)
      [o: (Option T)
       default-generator: (Fn [] T)]: T
      (match o
        (Some v) v
        None (default-generator)))

(defn update-grain [@var grain: Grain]: (Option Grain)
  (+= grain.pos
      (/ grain.speed (sample-rate)))
  (if (< (- grain.pos grain.start-pos)
         grain.len)
    (Some grain)
    None))

(defn into [@ref grain: Grain]: Grain
  (Grain grain.start-pos
         grain.len
         grain.speed
         grain.pos))

(defn hann-window [p: f32]: f32
  (-> p
      (* TAU)
      cos
      (- 1 <>)
      (* 0.5)))

(defn update-grainbank [@var @ref grainbank: [Grain]
                        grain-generator: (Fn [] Grain)]
  (for [i (array-length grainbank)]
    (= (grainbank i)
       (unwrap-or-else (update-grain ~(grainbank i))
                       grain-generator))))

(defn sample-wavetable [t: f32
                        @ref wavetable: [f32]]: f32
  (-> t
      (* (sample-rate))
      u32
      (if (< <> (array-length wavetable))
        (wavetable <>)
        0.)))

(defn sample-grain [@ref grain: Grain
                    @ref wavetable: [f32]
                    envelope: (Fn [f32] f32)]: f32
  (* (sample-wavetable (f32 grain.pos) wavetable)
     (envelope (/ (- grain.pos grain.start-pos)
                  grain.len))))

(defn sample-grain [@ref grain: Grain
                    @ref wavetable: [f32]]: f32
  (sample-grain grain wavetable hann-window))

(defn sample-grainbank [@ref grainbank: [Grain]
                        @ref wavetable: [f32]
                        envelope: (Fn [f32] f32)]: f32
  (let [@var sum 0.]
    (for [i (array-length grainbank)]
      (+= sum
          (sample-grain (grainbank i)
                        wavetable
                        envelope)))
    sum))

(defn sample-grainbank [@ref grainbank: [Grain]
                        @ref wavetable: [f32]]: f32
  (sample-grainbank grainbank
                    wavetable
                    hann-window))

(defn bi->uni [x: f32]: f32
  (-> x (+ 1.) (* 0.5)))

(defn bi->uni [x: vec2f]: vec2f
  (-> x (+ 1.) (* 0.5)))

(defn uni->bi [x: f32]: f32
  (-> x (* 2.) (- 1.)))

(defn uni->bi [x: vec2f]: vec2f
  (-> x (* 2.) (- 1.)))

(defn uni->bi [f: (Fn [] f32)]: (Fn [] f32)
  (fn [] (uni->bi (f))))

(defn (assoc T
             C: u32)
      [@var arr: [C: T]
       idx: u32
       value: T]: [C: T]
      (= (arr idx) value)
      arr)

(defn granular-sampler [grain-count: u32
                        wavetable: [f32]
                        grain-generator: (Fn [f32] Grain)]: (Fn [] f32)
  (let [@var grains: [Grain] (zeroed-array grain-count)]
    (for [i (array-length grains)]
      (= (grains i)
         (grain-generator 0.)))
    (fn []
        (update-grainbank grains
                          (fn []
                              (grain-generator (audio-time))))
        (-> (sample-grainbank grains
                              wavetable
                              #_(fn [p]
                                    1.
                                    #_(pow (hann-window p) 0.2)))
            (* 1.2)))))

(defn lowpass-comb [delay-samples: u32
                    feedback: f32
                    damp: f32]: (Fn [f32] f32)
  (let [@var buf (zeroed-array delay-samples): [f32]
        @var idx 0u
        @var lp 0.]
    (fn [x]
        (let [out (buf idx)]
          (= lp (mix out lp damp))
          (= (buf idx)
             (+ x (* feedback lp)))
          (= idx
             (% (+ idx 1u) delay-samples))
          out))))

(defn schroeder-allpass [delay-samples: u32
                         feedback: f32]: (Fn [f32] f32)
  (let [@var buf (zeroed-array delay-samples): [f32]
        @var idx 0u]
    (fn [x]
        (let [delayed (buf idx)]
          (= (buf idx)
             (+ x (* feedback delayed)))
          (= idx
             (% (+ idx 1u) delay-samples))
          (- delayed x)))))

(defn freeverb [signal: (Fn [] f32)
                room-size: f32
                damp: f32
                wet: f32]: (Fn [] f32)
  (let [feedback (+ 0.7 (* 0.28 room-size))
        damping (* 0.4 damp)
        tune (fn [n: f32]
                 (u32 (* n (/ (sample-rate) 44100.))))
        c1 (lowpass-comb (tune 1116.) feedback damping)
        c2 (lowpass-comb (tune 1188.) feedback damping)
        c3 (lowpass-comb (tune 1277.) feedback damping)
        c4 (lowpass-comb (tune 1356.) feedback damping)
        c5 (lowpass-comb (tune 1422.) feedback damping)
        c6 (lowpass-comb (tune 1491.) feedback damping)
        c7 (lowpass-comb (tune 1557.) feedback damping)
        c8 (lowpass-comb (tune 1617.) feedback damping)
        a1 (schroeder-allpass (tune 556.) 0.5)
        a2 (schroeder-allpass (tune 441.) 0.5)
        a3 (schroeder-allpass (tune 341.) 0.5)
        a4 (schroeder-allpass (tune 225.) 0.5)]
    (fn []
        (let [x (signal)
              in (* x 0.015)]
          (-> (+ (c1 in)
                 (c2 in)
                 (c3 in)
                 (c4 in)
                 (c5 in)
                 (c6 in)
                 (c7 in)
                 (c8 in))
              a1
              a2
              a3
              a4
              (* wet)
              (+ x))))))

(defn swirly-circle-path [p: f32
                          overdraw: f32
                          angle: f32
                          brush-characteristics: (Fn [f32] vec2f)]: vec3f
  (let [characteristics (brush-characteristics p)]
    (-> p
        uni->bi
        (* overdraw)
        (bi->uni)
        (* TAU)
        (+ angle)
        cis
        (* characteristics.x)
        (vec3f characteristics.y))))

(struct Out
  @{builtin position} pos: vec4f
  inner-pos: vec2f)

(defn frag [in: Out]: vec4f
  (when (> (length in.inner-pos) 1.)
    (discard))
  (vec4f 1.))

(defn mix-exp [low: f32
               high: f32
               x: f32]: f32
  (* low (pow (/ high low) x)))

@cpu
(defn main []: ()
  (spawn-window (fn []
                    (let [grid-size 4u
                          path-length 100u
                          window-scale (-> (window-resolution)
                                           vec2f
                                           (/ <> (min (.x <>) (.y <>))))
                          grid-scale (* (slider 0.7250337))
                          get-path-circle (fn [grid-coords: vec2u
                                               path-index: u32
                                               z-map: (Fn [f32] f32)]
                                              (let [grid-pos (-> grid-coords
                                                                 vec2f
                                                                 (/ (- (f32 grid-size) 1.)))
                                                    p (-> path-index
                                                          f32
                                                          (/ (f32 (- path-length 1))))
                                                    circle (swirly-circle-path p
                                                                               (* 2. (slider 0.5531989))
                                                                               (* TAU 0.25)
                                                                               (fn [p]
                                                                                   (vec2f (+ (slider 0.7176731)
                                                                                             (-> (* (slider 0.18114936)
                                                                                                    (sympow (uni->bi p)
                                                                                                            (+ 1. (* (slider 0.3943523) 20.))))
                                                                                                 -))
                                                                                          (-> p
                                                                                              (* TAU)
                                                                                              cos
                                                                                              -
                                                                                              bi->uni
                                                                                              (sympow (slider 0.26999977))
                                                                                              z-map
                                                                                              #_(mix-exp (slider 0.0051576197)
                                                                                                         (slider 0.1111625)
                                                                                                         <>)))))]
                                                (vec3f (* grid-scale
                                                          (+ (uni->bi grid-pos)
                                                             (/ circle.xy
                                                                (- (f32 grid-size) 1.))))
                                                       (.z circle))))]
                      (when (key-just-down? "p")
                        (for [x grid-size]
                          (for [y grid-size]
                            (let [@var circles (zeroed-array path-length): [vec3f]]
                              (for [i path-length]
                                (= (circles i)
                                   (get-path-circle (vec2u x y)
                                                    i
                                                    (fn [x] (* x 4)))))
                              (print circles)))))
                      (dispatch-render-shaders (fn []
                                                   (let [corner-index (% (vertex-index) 6)
                                                         grid-index (-> (vertex-index)
                                                                        (/ 6)
                                                                        (% (* grid-size grid-size)))
                                                         grid-coords (vec2u (% grid-index grid-size)
                                                                            (/ grid-index grid-size))
                                                         grid-pos (-> grid-coords
                                                                      vec2f
                                                                      (/ (- (f32 grid-size) 1.)))
                                                         p (-> (vertex-index)
                                                               (/ (* 6 grid-size grid-size))
                                                               f32
                                                               (/ (f32 (- path-length 1))))
                                                         circle (swirly-circle-path p
                                                                                    (* 2. (slider 0.5531989))
                                                                                    (* TAU 0.25)
                                                                                    (fn [p]
                                                                                        (vec2f (+ (slider 0.7176731)
                                                                                                  (-> (* (slider 0.18114936)
                                                                                                         (sympow (uni->bi p)
                                                                                                                 (+ 1. (* (slider 0.3943523) 20.))))
                                                                                                      -))
                                                                                               (-> p
                                                                                                   (* TAU)
                                                                                                   cos
                                                                                                   -
                                                                                                   bi->uni
                                                                                                   (sympow (slider 0.26999977))
                                                                                                   (mix-exp (slider 0.0051576197)
                                                                                                            (slider 0.1111625)
                                                                                                            <>)))))
                                                         circle2 (get-path-circle grid-coords
                                                                                  (-> (vertex-index)
                                                                                      (/ (* 6 grid-size grid-size)))
                                                                                  (fn [x]
                                                                                      (mix-exp (slider 0.0051576197)
                                                                                               (slider 0.1111625)
                                                                                               x)))
                                                         corner-pos ([(vec2f -1.)
                                                                      (vec2f 1. -1.)
                                                                      (vec2f -1. 1.)
                                                                      (vec2f 1.)
                                                                      (vec2f 1. -1.)
                                                                      (vec2f -1. 1.)]
                                                                     corner-index)]
                                                     (Out (vec4f (/ (+ circle2.xy
                                                                       (* (/ grid-scale
                                                                             (- (f32 grid-size) 1.))
                                                                          (* circle2.z corner-pos)))
                                                                    window-scale)
                                                                 0.
                                                                 1.)
                                                          corner-pos)))
                                               frag
                                               (* 6
                                                  path-length
                                                  (* grid-size grid-size)))))))

