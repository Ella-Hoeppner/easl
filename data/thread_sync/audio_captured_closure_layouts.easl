; An audio entry calling a captured closure whose scope mixes layouts:
; mutable state (a vec3f followed by an f32 — padding in a struct
; layout), a matrix, a fixed array of vec3fs, an i32, and a bool. The k-th
; sample is 0.01 (0.02k + 4 + 8 + 14 - 15 + 1 + k) = 0.12 + 0.0102k.
(defn make-voice [v: vec3f
                  s: f32
                  m: mat2x2f
                  vs: [2: vec3f]
                  n: i32
                  flag: bool]: (Fn [] f32)
  (let [@var acc (vec3f 0.)
        @var count 0.]
    (fn []
      (+= acc (* v 0.01))
      (+= count 1.)
      (* 0.01
         (+ (.y acc)
            s
            (.y (m 1u))
            (.z (vs 1u))
            (f32 n)
            (if flag 1. 0.)
            count)))))

@cpu
(defn main []
  (let [voice (make-voice (vec3f 1. 2. 3.)
                          4.
                          (mat2x2f 5. 6. 7. 8.)
                          [(vec3f 9. 10. 11.) (vec3f 12. 13. 14.)]
                          -15i
                          true)]
    (start-audio (fn [] (voice))))
  (spawn-window (fn [] ())))
