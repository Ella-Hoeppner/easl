; As `audio_closure_bank`, but the bank holds two DIFFERENT closure kinds —
; a rising and a falling ramp — so its elements are a tagged union
; dispatched at runtime. Each oscillator must still advance on every sample.
(defn create-rising [increment: f32]: (Fn [] f32)
  (let [@var phase 0.]
    (fn []
      (= phase
         (% (+ phase increment) 1.))
      phase)))

(defn create-falling [decrement: f32]: (Fn [] f32)
  (let [@var level 1.]
    (fn []
      (= level (- level decrement))
      (when (< level 0.)
        (= level 1.))
      level)))

(defn mix [oscs: [2: (Fn [] f32)]]: (Fn [] f32)
  (fn []
    (* 0.5
       (+ ((oscs 0u)) ((oscs 1u))))))

@cpu
(defn main []
  (start-audio (mix [(create-rising 0.125) (create-falling 0.25)]))
  (spawn-window (fn [] ())))
