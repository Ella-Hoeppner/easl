; Only genuinely-shared variables sync: `mainside` is touched by the main
; thread only, `audioside` by the audio thread only — neither may ever be
; published or adopted, even though both are written every iteration. Only
; `both` (written by main, read by audio) is thread-shared, and the
; bootstrap publish at start-audio enumerates exactly the shared set.
(var mainside: f32
     1.)

(var audioside: f32
     2.)

(var both: f32
     3.)

@audio
(defn f [t: f32
         rate: f32]: f32
  (= audioside (+ audioside 1.))
  (* both 0.1))

@cpu
(defn main []
  (spawn-window (fn []
                    (start-audio f)
                    (= mainside (+ mainside 1.))
                    (= both (+ both 1.)))))

