; `reset-audio-time` restarts the audio clock from the audio thread's next
; batch: `(audio-time)` counts from 0 again (n/8 at 8 samples per second).
; The reset happens in frame 1 only, so the last batch carries on from where
; the reset left it.
(defn clock []: f32
  (audio-time))

@cpu
(defn main []
  (start-audio clock)
  (let [@var frame 0u]
    (spawn-window (fn []
                    (when (== frame 1u)
                      (reset-audio-time))
                    (+= frame 1u)))))
