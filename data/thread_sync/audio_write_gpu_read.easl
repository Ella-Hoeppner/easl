; Audio-thread writes must reach the GPU: the audio function records its
; latest sample time into `level` (a uniform binding), a compute shader
; copies `level` into `out`, and main prints `out`. The flow is
; audio-publish at batch end → main-adopt at frame start (which marks the
; GPU copy stale) → upload before the frame's dispatch → GPU reads the
; adopted value.
@uniform
(var level: f32)

@storage-write
(var out: [1: f32])

@audio
(defn f [t: f32]: f32
  (= level t)
  0.)

@{workgroup-size 1}
@compute
(defn copy-level []
  (= (out 0u) level))

@cpu
(defn main []
  (spawn-window (fn []
                    (start-audio f)
                    (dispatch-compute-shader copy-level (vec3u 1u))
                    (print (out 0u)))))

