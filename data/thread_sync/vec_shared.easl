; A multi-slot (vec2f) shared variable: the snapshot carries all
; components, and both runtimes' word layouts must agree.
(var offset: vec2f)

@audio
(defn f [t: f32
         rate: f32]: f32
  (- offset.y offset.x))

@cpu
(defn main []
  (spawn-window (fn []
                    (start-audio f)
                    (= offset
                       (+ offset (vec2f 0.25 0.5))))))

