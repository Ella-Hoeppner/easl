; `@local` is never shared: each execution context owns an independent
; copy — the audio replica runs its own initializer and keeps its own
; state, main's writes stay on main, and no publish or adopt of `phase`
; may ever appear, even though both threads touch it every iteration.
; (To share, use the default storage-write space instead.)
@local
(var phase: f32 0.5)

@audio
(defn f [t: f32]: f32
  (= phase (+ phase 0.125))
  phase)

@cpu
(defn main []
  (spawn-window (fn []
                    (start-audio f)
                    (= phase 100.)
                    (print phase))))
