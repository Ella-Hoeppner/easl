; The GPU→cross-thread publish path costs nothing until a second thread
; exists: `height` is statically thread-shared (the audio entry reads it,
; the GPU writes it via a main-dispatched shader), but start-audio is
; never called, so the frame-boundary publish must NOT read the GPU-dirty
; buffer back — no readback, no publish, ever.
@storage-write
(var height: [1: f32])

@audio
(defn f [t: f32]: f32
  (height 0u))

@{workgroup-size 1}
@compute
(defn rise []
  (= (height 0u)
     (+ (height 0u) 0.25)))

@cpu
(defn main []
  (spawn-window (fn []
                    (dispatch-compute-shader rise (vec3u 1u)))))

