; Readbacks inside frames, alongside screen draws and CPU writes that upload
; before the next dispatch; closing the window resumes `main`.
(var counter: [2: u32])

@compute
(defn bump []
  (+= (counter 0u) 1u))

@cpu
(defn main []
  (dispatch-compute-shader bump (vec3u 1u))
  (print (counter 0u))
  (spawn-window
    (fn []
      (dispatch-render-shaders
        (fn [] (match (vertex-index)
                 0 (vec4f -1. -1. 0. 1.)
                 1 (vec4f -1. 3. 0. 1.)
                 _ (vec4f 3. -1. 0. 1.)))
        (fn [] (vec4f 0. 0.5 1. 1.))
        3)
      (dispatch-compute-shader bump (vec3u 1u))
      (print (counter 0u))
      (= (counter 1u) (* 10u (counter 0u)))
      (when (>= (counter 0u) 4u) (close-window))))
  (dispatch-compute-shader bump (vec3u 1u))
  (print counter))
