; Used by `concat_allocates_exactly` in vm_tests.rs: each `concat`'s result
; must be allocated at exactly its length (building a long string by
; repeated `concat` once peaked at ~35x its size).
(defn flat []: [f32]
  (concat (into-dynamic-array [1. 2. 3.]) (into-dynamic-array [4. 5.])))

(defn nested []: [[f32]]
  (concat (into-dynamic-array [(into-dynamic-array [1.])])
          (into-dynamic-array [(into-dynamic-array [2.])
                               (into-dynamic-array [3.])])))

(defn text []: String
  (concat "abc" "de"))

@cpu
(defn main []
  (print (flat))
  (print (nested))
  (print (text)))
