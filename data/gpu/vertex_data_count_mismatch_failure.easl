(var corners: [3: vec2f])

@vertex
(defn data-vert [corner: vec2f]: vec4f
  (vec4f corner 0. 1.))

@vertex
(defn plain-vert []: vec4f
  (vec4f 0.))

@fragment
(defn frag []: vec4f
  (vec4f 1.))

@cpu
(defn main []
  (spawn-window
    (fn []
      (dispatch-render-shaders data-vert frag 3u)
      (dispatch-render-shaders plain-vert frag corners))))
