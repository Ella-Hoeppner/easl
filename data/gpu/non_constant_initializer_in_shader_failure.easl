; Shaders can't read a top-level value whose initializer calls a function:
; directly, through a helper, or through a `@local` var; or builds an enum
; value from a payload the compiler can't compute (`sin`), which WGSL would
; need a non-constant `bitcast` for. A computable payload is fine.
(defn twice [x: u32]: u32
  (* 2u x))

(def doubled: u32 (twice 3u))

@local
(var start: u32 (twice 4u))

(def plain: u32 5u)

(def wave: (Option f32) (Some (sin 1.)))

(def fine: (Option f32) (Some (* 2. 0.5)))

(defn or-zero [o: (Option f32)]: f32
  (match o
    (Some v) v
    None 0.))

(defn read-doubled []: u32
  doubled)

@vertex
(defn vert []: vec4f
  (vec4f (f32 (read-doubled))))

@fragment
(defn frag []: vec4f
  (vec4f (+ (f32 (+ start plain)) (or-zero wave) (or-zero fine))))
