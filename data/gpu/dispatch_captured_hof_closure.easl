; A dispatched closure capturing a closure that itself takes a FUNCTION
; argument: higher-order inlining specializes the capture's call sites
; before the dispatch lift runs, so the lift must clone the
; specializations (which share the one set of lifted capture globals),
; not just the original definition.
(defn frag []: vec4f
  (vec4f 1.))

@cpu
(defn main []
  (spawn-window (fn []
                  (let [scale 2.
                        helper (fn [x: f32
                                    f: (Fn [f32] f32)]
                                 (* scale (f x)))]
                    (dispatch-render-shaders
                      (fn []
                        (vec4f (helper (f32 (vertex-index))
                                       (fn [x] (+ x 1.)))
                               0.
                               0.
                               1.))
                      frag
                      3)))))
