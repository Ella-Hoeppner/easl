; A function capturing the closure it was lent into the closure it returns,
; while the caller keeps using the original.
(defn make-counter [amount: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n amount)
      n)))

(defn twice-each [g: (Fn [] f32)]: (Fn [] f32)
  (fn []
    (g)
    (g)))

@cpu
(defn main []
  (let [c (make-counter 1.)
        w (twice-each c)]
    (print (w))
    (print (c))))
