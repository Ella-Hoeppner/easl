; A dispatched closure calling a captured closure that captures a bool: the
; capture's global holds the closure's scope, stored with its bool as a
; `u32` (see `host_encoding`).
(defn make-pick [flag: bool]: (Fn [] f32)
  (fn [] (if flag 1. 0.)))

@storage-write
(var out: [1: f32])

@cpu
(defn main []
  (let [pick (make-pick true)]
    (dispatch-compute-shader (fn [] (= (out 0u) (pick)))
                             (vec3u 1u))))
