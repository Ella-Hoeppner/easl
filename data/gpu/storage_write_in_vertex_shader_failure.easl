; Vertex shaders can't write GPU memory in WebGPU (without extensions,
; which easl doesn't use), so writing a storage-write var from one is a
; compile error on every runtime.
@storage-write
(var x: u32)

@vertex
(defn vert [@{builtin vertex-index} i: u32]: vec4f
  (when (== i 0u)
    (= x (* x x)))
  (vec4f -1. -1. 0. 1.))

@fragment
(defn frag []: vec4f
  (vec4f 0.))

@cpu
(defn main []
  (spawn-window (fn []
                  (= x 5)
                  (dispatch-render-shaders vert frag 3)
                  (print x)
                  (close-window))))
