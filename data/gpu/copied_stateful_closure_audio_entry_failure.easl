; An audio entry runs every sample and keeps its captured variables, so a
; closure it builds capturing a stateful closure copies one that stays in
; use.
(defn create-counter [increment: f32]: (Fn [] f32)
  (let [@var phase 0.]
    (fn []
      (= phase (% (+ phase increment) 1.))
      phase)))

@cpu
(defn main []
  (let [osc (create-counter 0.125)]
    (start-audio (fn []
                   (let [h (fn [] (osc))]
                     (h))))))
