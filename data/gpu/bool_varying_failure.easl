; WGSL can't pass a bool between stages or give one a location, so a bool
; varying is rejected, like a bool vector one, and so is a located bool
; parameter. A bool can still be a builtin input (`front-facing`, in
; `bool_bindings`).
(struct Varyings
  @{builtin position} position: vec4f
  lit: bool)

@vertex
(defn vert [@{builtin vertex-index} i: u32]: Varyings
  (Varyings (vec4f 0. 0. 0. 1.) (== i 0u)))

@fragment
(defn frag [in: Varyings]: vec4f
  (if in.lit (vec4f 1.) (vec4f 0.)))

@fragment
(defn located-frag [@{location 0} lit: bool]: vec4f
  (if lit (vec4f 1.) (vec4f 0.)))
