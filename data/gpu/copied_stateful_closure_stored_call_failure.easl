; The same through a stored function: the stored factory captures the lent
; closure while the caller keeps using it.
(defn make-counter [amount: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n amount)
      n)))

(defn twice-each [g: (Fn [] f32)]: (Fn [] f32)
  (fn []
    (g)
    (g)))
(defn once-each [g: (Fn [] f32)]: (Fn [] f32)
  (fn [] (g)))

@cpu
(defn main []
  (let [ws [twice-each once-each]
        c (make-counter 1.)
        w ((ws 0u) c)]
    (print (w))
    (print (c))))
