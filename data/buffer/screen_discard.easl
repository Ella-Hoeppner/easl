; A fragment shader that discards, from the tail of a branch: in its own
; body, and in a helper whose value it returns otherwise. A function ending
; in a branch that discards needs a `return` after the `discard` in WGSL
; (`discard` doesn't end it there), which browsers insist on. The draws
; blend additively, so the discarded red never reaches the screen and the
; kept green does.

(var cutoff: f32)

(var level: f32)

@local
(var frame: u32 0u)

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@fragment
(defn discarded-red []: vec4f
  (if (> cutoff 0.5)
    (discard)
    (vec4f 1. 0. 0. 1.)))

(defn kept-above [x: f32 threshold: f32]: f32
  (if (< x threshold)
    (discard)
    x))

@fragment
(defn kept-green []: vec4f
  (vec4f 0. (kept-above level 0.25) 0. 1.))

@cpu
(defn main []
  (spawn-window
    (fn []
      (if (== frame 0u)
        (do (= cutoff 1.)
            (= level 0.5)
            (set-blend BlendFactor/One BlendFactor/One BlendOperation/Add)
            (dispatch-render-shaders fullscreen discarded-red 3u)
            (dispatch-render-shaders fullscreen kept-green 3u))
        (close-window))
      (= frame (+ frame 1u)))))
