; A dispatched closure calling a captured closure whose scope mixes layouts
; (a vec3f followed by an f32, a matrix, a fixed array of vec3fs, an i32,
; a vec2u): every captured value reaches the shader intact.
(defn make-probe [v: vec3f
                  s: f32
                  m: mat2x2f
                  vs: [2: vec3f]
                  n: i32
                  w: vec2u]: (Fn [u32] f32)
  (fn [i]
    (match i
      0u (.y v)
      1u s
      2u (.y (m 1u))
      3u (.z (vs 1u))
      4u (f32 n)
      _ (f32 (.y w)))))

@storage-write
(var out: [6: f32])

@cpu
(defn main []
  (let [probe (make-probe (vec3f 1. 2. 3.)
                          4.
                          (mat2x2f 5. 6. 7. 8.)
                          [(vec3f 9. 10. 11.) (vec3f 12. 13. 14.)]
                          -15i
                          (vec2u 16u 17u))]
    (dispatch-compute-shader
      (fn []
        (for [i 6u]
          (= (out i) (probe i))))
      (vec3u 1u))
    (print out)))
