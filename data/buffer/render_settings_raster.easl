; Face culling by winding (counter-clockwise faces front by default), the
; front face flipped, a point-list draw, and `clear-target` setting the
; screen's background, folded into a draw's pass or alone.

@local
(var frame: u32 0u)

@vertex
(defn counter-clockwise [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@vertex
(defn clockwise [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f -1. 3. 0. 1.)
    _ (vec4f 3. -1. 0. 1.)))

; The center of the top-left pixel (the one the tests read), whatever the
; screen's size.
@vertex
(defn corner [@{builtin vertex-index} i: u32]: vec4f
  (let [pixel (/ (vec2f 2.) (vec2f (window-resolution)))]
    (vec4f (+ -1. (* 0.5 pixel.x)) (- 1. (* 0.5 pixel.y)) 0. 1.)))

@fragment
(defn red []: vec4f
  (vec4f 1. 0. 0. 1.))

@fragment
(defn green []: vec4f
  (vec4f 0. 1. 0. 1.))

@fragment
(defn blue []: vec4f
  (vec4f 0. 0. 1. 1.))

@cpu
(defn main []
  (spawn-window
    (fn []
      (match frame
        0u (do (set-cull-mode CullMode/Back)
               ; back-facing: culled
               (dispatch-render-shaders clockwise red 3u)
               (dispatch-render-shaders counter-clockwise green 3u))
        1u (do (set-front-face FrontFace/Clockwise)
               ; now back-facing: culled
               (dispatch-render-shaders counter-clockwise red 3u)
               (dispatch-render-shaders clockwise blue 3u))
        2u (do (reset-render-settings)
               (set-topology Topology/PointList)
               (dispatch-render-shaders corner green 1u))
        3u (do (reset-render-settings)
               (set-cull-mode CullMode/Back)
               (clear-target (vec4f 1. 0. 1. 1.))
               ; culled: the background shows
               (dispatch-render-shaders clockwise red 3u))
        4u (clear-target (vec4f 0. 1. 1. 1.))
        _ (close-window))
      (= frame (+ frame 1u)))))
