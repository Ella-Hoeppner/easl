; Thousands of render passes in a row (alternating between two targets),
; with nothing else in between, then a read of what they rendered.

@handle
(var a: (Texture2D f32))
@handle
(var b: (Texture2D f32))
(var value: vec4f)

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@fragment
(defn red []: vec4f (vec4f 1. 0. 0. 1.))

@compute
(defn read-b []
  (= value (texture-load b (vec2u 0u) 0u)))

@cpu
(defn main []
  (= a (blank-texture (vec2u 1u)))
  (= b (blank-texture (vec2u 1u)))
  (for [i 1500u]
    (set-render-target a)
    (dispatch-render-shaders fullscreen red 3u)
    (set-render-target b)
    (dispatch-render-shaders fullscreen red 3u))
  (clear-render-target)
  (dispatch-compute-shader read-b (vec3u 1u))
  (print value))
