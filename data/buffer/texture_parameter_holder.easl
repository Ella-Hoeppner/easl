; A function parameter holding a texture counts as a holder: reassigning the
; global it came from while the parameter holds the texture gives the global
; a new texture rather than rewriting the shared one. (Tree-walker only: the
; VM holds textures only in globals so far.)

@handle
(var a: (Texture2D f32))
@handle
(var c: (Texture2D f32))

(var results: [2: vec4f])

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@fragment
(defn blue []: vec4f (vec4f 0. 0. 1. 1.))

@compute
(defn read-a-and-c []
  (= (results 0u) (texture-load a (vec2u 0u) 0u))
  (= (results 1u) (texture-load c (vec2u 0u) 0u)))

(defn blue-path []: String
  "../../out/buffer/texture_parameter_holder_blue.png")

(defn reload-keeping [held: (Texture2D f32)]
  (= a (load-image (blue-path)))
  (= c held))

@cpu
(defn main []
  (= c (blank-texture (vec2u 1u)))
  (set-render-target c)
  (dispatch-render-shaders fullscreen blue 3u)
  (clear-render-target)
  (save-png c (blue-path))
  (= a (load-image "red_pixel.png"))
  (reload-keeping a)
  (dispatch-compute-shader read-a-and-c (vec3u 1u))
  (print results))
