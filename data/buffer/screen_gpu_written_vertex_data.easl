; Vertex data written on the GPU. Frame 0: a compute shader writes the
; triangle a draw then reads as vertex data. Frame 1: a draw's fragment
; shader moves a corner, collapsing the triangle, and a later draw reading
; it as vertex data (in a pass of its own: one pass can't write a buffer
; and read it as vertex data) draws nothing, leaving the first draw's
; green. Frame 2: the CPU writes the triangle back.
(var triangle: [3: vec2f])

@compute
(defn build []
  (= triangle [(vec2f -1. -1.) (vec2f 3. -1.) (vec2f -1. 3.)]))

@vertex
(defn data-vert [corner: vec2f]: vec4f
  (vec4f corner 0. 1.))

@vertex
(defn full-vert [@{builtin vertex-index} i: u32]: vec4f
  (vec4f (match i
           0u (vec2f -1. -1.)
           1u (vec2f 3. -1.)
           _ (vec2f -1. 3.))
         0.
         1.))

@fragment
(defn red []: vec4f
  (vec4f 1. 0. 0. 1.))

@fragment
(defn collapse []: vec4f
  (= (triangle 0u) (vec2f -1. 3.))
  (vec4f 0. 1. 0. 1.))

@local
(var frame: u32 0u)

@cpu
(defn main []
  (spawn-window
    (fn []
      (match frame
        0u (do (dispatch-compute-shader build (vec3u 1u))
               (dispatch-render-shaders data-vert red triangle))
        1u (do (dispatch-render-shaders full-vert collapse 3u)
               (dispatch-render-shaders data-vert red triangle))
        2u (do (= triangle [(vec2f -1. -1.) (vec2f 3. -1.) (vec2f -1. 3.)])
               (dispatch-render-shaders data-vert red triangle))
        _ (close-window))
      (= frame (+ frame 1u)))))
