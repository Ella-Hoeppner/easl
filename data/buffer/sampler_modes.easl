; Samplers made on the CPU control how shaders read textures. `tex` is two
; texels wide: red on the left, blue on the right (texel centers at u = 0.25
; and u = 0.75).

@handle
(var tex: (Texture2D f32))

(var default-sampler: Sampler)
(var linear: Sampler)
(var repeating: Sampler)
(var mirrored: Sampler)
(var clamped: Sampler)

(var results: [6: vec4f])

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@fragment
(defn paint [@{builtin position} p: vec4f]: vec4f
  (if (< p.x 1.)
    (vec4f 1. 0. 0. 1.)
    (vec4f 0. 0. 1. 1.)))

@compute
(defn sample-all []
  ; nearest by default: the closer texel, no blending
  (= (results 0u) (texture-sample-level tex default-sampler (vec2f 0.4 0.5) 0.))
  ; clamp-to-edge by default: past the right edge reads the right texel
  (= (results 1u) (texture-sample-level tex default-sampler (vec2f 1.25 0.5) 0.))
  ; linear: halfway between the texel centers blends them evenly
  (= (results 2u) (texture-sample-level tex linear (vec2f 0.5 0.5) 0.))
  ; repeat: u = 1.25 reads like u = 0.25
  (= (results 3u) (texture-sample-level tex repeating (vec2f 1.25 0.5) 0.))
  ; mirror-repeat: u = 1.6 reads like u = 0.4
  (= (results 4u) (texture-sample-level tex mirrored (vec2f 1.6 0.5) 0.))
  ; clamp-to-edge: u = 1.6 reads the right texel
  (= (results 5u) (texture-sample-level tex clamped (vec2f 1.6 0.5) 0.)))

@cpu
(defn main []
  (= tex (blank-texture (vec2u 2u 1u)))
  (set-render-target tex)
  (dispatch-render-shaders fullscreen paint 3u)
  (clear-render-target)
  (= linear (Sampler FilterMode/Linear AddressMode/ClampToEdge))
  (= repeating (Sampler FilterMode/Nearest AddressMode/Repeat))
  (= mirrored (Sampler FilterMode/Nearest AddressMode/MirrorRepeat))
  (= clamped (Sampler FilterMode/Nearest AddressMode/ClampToEdge))
  (print default-sampler)
  (print mirrored)
  (dispatch-compute-shader sample-all (vec3u 1u))
  (print results)
  ; reassigning a sampler takes effect for later dispatches
  (= repeating (Sampler FilterMode/Nearest AddressMode/ClampToEdge))
  (= mirrored (Sampler FilterMode/Nearest AddressMode/ClampToEdge))
  (dispatch-compute-shader sample-all (vec3u 1u))
  (print (results 3u))
  (print (results 4u)))
