; Stateful closures in an array inside a compute shader advance in place.
(defn make-counter [inc: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n inc)
      n)))
@storage-write
(var out: [4: f32])
@cpu
(defn main []
  (dispatch-compute-shader
    (fn []
      (let [@var cs [(make-counter 1.) (make-counter 10.)]]
        (= (out 0u) ((cs 0u)))
        (= (out 1u) ((cs 0u)))
        (= (out 2u) ((cs 1u)))
        (= (out 3u) ((cs 0u)))))
    (vec3u 1u))
  (print out))
