; A fragment shader closure capturing a closure, and building a closure
; that captures that closure along with a per-frame value, with different
; captured values each frame (the frame that closes the window isn't
; shown, so two frames draw).
(defn make-scale [k: f32]: (Fn [f32] f32)
  (fn [x] (* x k)))

@local
(var frame: u32 0u)

@cpu
(defn main []
  (spawn-window
    (fn []
      (if (< frame 2u)
        (let [f (make-scale (* 0.8 (f32 (+ frame 1u))))
              t 0.2]
          (dispatch-render-shaders
            (fn []
              (vec4f (match (vertex-index)
                       0 (vec2f -1.)
                       1 (vec2f -1. 3.)
                       _ (vec2f 3. -1.))
                     0.
                     1.))
            (fn []
              (let [h (fn [x] (+ (f x) t))]
                (vec4f (f 0.25) (h 0.5) 0. 1.)))
            3u))
        (close-window))
      (= frame (+ frame 1u)))))
