; Instanced draws. Every instance is a full-screen triangle that adds 0.125
; red, so the red channel counts the instances drawn; the instance with
; `instance-index` 2 adds 0.25 green too. Frame 0 draws 4 instances, frame 1
; an explicit 1, frame 2 the three-argument form (one instance), and frame 3
; zero instances, drawing nothing. The counts come from a runtime value.
(struct Varyings
  @{builtin position} position: vec4f
  @{location 0} color: vec4f)

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32
                  @{builtin instance-index} instance: u32]: Varyings
  (Varyings
    (match i
      0u (vec4f -1. -1. 0. 1.)
      1u (vec4f 3. -1. 0. 1.)
      _ (vec4f -1. 3. 0. 1.))
    (vec4f 0.125 (if (== instance 2u) 0.25 0.) 0. 0.)))

@fragment
(defn shade [in: Varyings]: @{location 0} vec4f
  (+ in.color (vec4f 0. 0. 0. 1.)))

@local
(var frame: u32 0u)

@cpu
(defn main []
  (set-blend BlendFactor/One BlendFactor/One BlendOperation/Add)
  (spawn-window
    (fn []
      (let [instances (match frame
                        0u 4u
                        3u 0u
                        _ 1u)]
        (match frame
          2u (dispatch-render-shaders fullscreen shade 3u)
          4u (close-window)
          _ (dispatch-render-shaders fullscreen shade 3u instances)))
      (= frame (+ frame 1u)))))
