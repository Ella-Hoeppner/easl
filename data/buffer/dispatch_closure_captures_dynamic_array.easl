; A GPU-dispatched closure captures a *local* runtime-sized array, and the
; GPU reads it. Each capture travels to the GPU as its own storage
; binding (see `extract_dispatched_closure_scopes`), so a runtime-sized
; capture is just an ordinary storage-bound array.
@[storage-write 0 0]
(var out: [1: f32])

@cpu
(defn main []
  (let [weights (into-dynamic-array [1. 2. 3.])]
    (dispatch-compute-shader (fn []
                                 (= (out 0u)
                                    (+ (weights 0u) (weights 2u))))
                             (vec3u 1u))
    (print (out 0u))))
