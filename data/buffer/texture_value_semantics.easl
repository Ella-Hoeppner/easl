; Texture values are handles to GPU textures, with value semantics:
; assigning one shares the texture (no pixel copy), and rendering into a
; texture another variable shares gives the rendered-into variable its own
; copy first.

@handle
(var a: (Texture2D f32))
@handle
(var b: (Texture2D f32))
@handle
(var c: (Texture2D f32))

(var results: [5: vec4f])

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@fragment
(defn red []: vec4f (vec4f 1. 0. 0. 1.))

@fragment
(defn green []: vec4f (vec4f 0. 1. 0. 1.))

@fragment
(defn blue []: vec4f (vec4f 0. 0. 1. 1.))

@compute
(defn read-a-and-b []
  (= (results 0u) (texture-load a (vec2u 0u) 0u))
  (= (results 1u) (texture-load b (vec2u 0u) 0u)))

@compute
(defn read-c []
  (= (results 2u) (texture-load c (vec2u 0u) 0u)))

@cpu
(defn main []
  (= a (blank-texture (vec2u 1u)))
  ; a copy made after a render sees what was rendered
  (set-render-target a)
  (dispatch-render-shaders fullscreen red 3u)
  (clear-render-target)
  (= b a)
  (dispatch-compute-shader read-a-and-b (vec3u 1u))
  (print (results 0u))
  (print (results 1u))
  ; rendering into `a` while `b` shares its texture leaves `b` as it was
  (set-render-target a)
  (dispatch-render-shaders fullscreen green 3u)
  (clear-render-target)
  (dispatch-compute-shader read-a-and-b (vec3u 1u))
  (print (results 0u))
  (print (results 1u))
  ; rendering into the copy leaves the original as it was
  (= c a)
  (set-render-target c)
  (dispatch-render-shaders fullscreen blue 3u)
  (clear-render-target)
  (dispatch-compute-shader read-a-and-b (vec3u 1u))
  (dispatch-compute-shader read-c (vec3u 1u))
  (print (results 0u))
  (print (results 2u))
  ; a copy taken between two queued renders into `a` holds the first
  (set-render-target a)
  (dispatch-render-shaders fullscreen red 3u)
  (= b a)
  (dispatch-render-shaders fullscreen blue 3u)
  (clear-render-target)
  (dispatch-compute-shader read-a-and-b (vec3u 1u))
  (print (results 0u))
  (print (results 1u))
  ; the copy `a` gets for its render is made where that render is in the
  ; program, even though both renders run later: `b`'s texture (the copy's
  ; source) is rendered into before anything runs, and `a` doesn't see it
  (= a (blank-texture (vec2u 1u)))
  (= b a)
  (set-render-target a)
  (dispatch-render-shaders fullscreen red 3u)
  (set-render-target b)
  (dispatch-render-shaders fullscreen green 3u)
  (clear-render-target)
  (dispatch-compute-shader read-a-and-b (vec3u 1u))
  (print (results 0u))
  (print (results 1u))
  (print (texture-dimensions b)))
