; Assigning new pixels to a texture variable rewrites its texture in place
; when no other value holds it (no new GPU texture), and otherwise gives the
; variable a new texture. In-place writes happen in program order: GPU work
; recorded before one sees the old pixels.

@handle
(var a: (Texture2D f32))
@handle
(var b: (Texture2D f32))

(var results: [3: vec4f])

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@fragment
(defn blue []: vec4f (vec4f 0. 0. 1. 1.))

@compute
(defn read-a-0 []
  (= (results 0u) (texture-load a (vec2u 0u) 0u)))

@compute
(defn read-a-1 []
  (= (results 1u) (texture-load a (vec2u 0u) 0u)))

@compute
(defn read-b []
  (= (results 2u) (texture-load b (vec2u 0u) 0u)))

(defn blue-path []: String
  "../../out/buffer/texture_in_place_writes_blue.png")

@cpu
(defn main []
  (= a (blank-texture (vec2u 1u)))
  (set-render-target a)
  (dispatch-render-shaders fullscreen blue 3u)
  (clear-render-target)
  (save-png a (blue-path))
  ; two in-place rewrites, each after a queued read of the old pixels
  (= a (load-image "red_pixel.png"))
  (dispatch-compute-shader read-a-0 (vec3u 1u))
  (= a (load-image (blue-path)))
  (dispatch-compute-shader read-a-1 (vec3u 1u))
  (print (results 0u))
  (print (results 1u))
  ; `b` shares `a`'s texture, so rewriting `a` leaves `b` as it was
  (= b a)
  (= a (load-image "red_pixel.png"))
  (dispatch-compute-shader read-a-0 (vec3u 1u))
  (dispatch-compute-shader read-b (vec3u 1u))
  (print (results 0u))
  (print (results 2u)))
