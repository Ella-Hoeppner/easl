; Elided binding numbers wire up correctly across the CPU/GPU boundary:
; the CPU writes an elided uniform and storage buffer, the GPU computes
; through them into an elided storage-write buffer, and the CPU reads the
; results back. One explicitly-numbered binding sits at `0 1` to force
; the assigner to fill gaps around it.
@[uniform]
(var scale: f32)

@[uniform 0 1]
(var offset: f32)

@[storage]
(var weights: [4: f32])

@[storage-write]
(var results: [4: f32])

@{workgroup-size 4}
@compute
(defn run [@{builtin global-invocation-id} id: vec3u]
  (let [i (.x id)]
    (when (< i 4u)
      (= (results i) (+ offset (* scale (weights i)))))))

@cpu
(defn main []
  (= scale 3.)
  (= offset 100.)
  (= weights [1. 2. 3. 4.])
  (dispatch-compute-shader run (vec3u 1u))
  (print results))
