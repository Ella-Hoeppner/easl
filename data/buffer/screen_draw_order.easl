; Screen draws run in program order with the frame's other GPU work: each
; draw sees the CPU writes made before it and the compute dispatched before
; it, and nothing that comes after it in the frame.

(var level: f32)
(var seen: f32)

; The frame that closes the window isn't shown, so the draws happen a frame
; earlier.
@local
(var frame: u32 0u)

@compute
(defn raise []
  (= level 1.))

@compute
(defn observe []
  (= seen level))

@vertex
(defn fullscreen [@{builtin vertex-index} i: u32]: vec4f
  (match i
    0u (vec4f -1. -1. 0. 1.)
    1u (vec4f 3. -1. 0. 1.)
    _ (vec4f -1. 3. 0. 1.)))

@fragment
(defn level-red []: vec4f
  (vec4f level 0. 0. 1.))

@fragment
(defn level-blue []: vec4f
  (vec4f 0. 0. level 1.))

@fragment
(defn level-green []: vec4f
  (vec4f 0. level 0. 1.))

@cpu
(defn main []
  (spawn-window
    (fn []
      (if (== frame 0u)
        (do (= level 0.2)
            (dispatch-render-shaders fullscreen level-red 3u)
            (= level 0.4)
            (dispatch-render-shaders fullscreen level-blue 3u true)
            (dispatch-compute-shader observe (vec3u 1u))
            (dispatch-compute-shader raise (vec3u 1u))
            (dispatch-render-shaders fullscreen level-green 3u true)
            (print seen))
        (close-window))
      (= frame (+ frame 1u)))))
