; Dispatching GPU entry points from a spawn-window frame closure that
; captures local scope. The captured `@var frame` makes the frame callback
; a scoped closure; the dispatched entries (a named vertex fn, a fragment
; lambda, and a compute lambda) must still make it into the GPU entry
; table even though the dispatch calls live inside that closure.

@{group 0
  binding 0}
(var tex: (Texture2D f32))

@[storage-write 0 1]
(var value: vec4f)

(defn fullscreen-triangle []: vec4f
  (vec4f (match (vertex-index)
           0 (vec2f -1.)
           1 (vec2f -1. 3.)
           _ (vec2f 3. -1.))
         0.
         1.))

@cpu
(defn main []
  (= tex (blank-texture (vec2u 2u)))
  (let [@var frame 0u]
    (spawn-window
      (fn []
        (when (== frame 1u)
          (print value)
          (close-window))
        (set-render-target tex)
        (dispatch-render-shaders fullscreen-triangle
                                 (fn [] (vec4f 1. 0. 0. 1.))
                                 3)
        (clear-render-target)
        (dispatch-compute-shader (fn []
                                     (= value
                                        (texture-load tex (vec2u 1u) 0u)))
                                 (vec3u 1u))
        (+= frame 1u)))))
