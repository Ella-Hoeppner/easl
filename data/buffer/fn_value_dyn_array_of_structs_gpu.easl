; A runtime-sized array of structs holding different closures (with
; different captured state), built on the CPU, captured by a dispatched
; compute shader, and called on the GPU.
(struct Shape
  sdf: (Fn [vec3f] f32)
  scale: f32)

(defn sphere [radius: f32]: (Fn [vec3f] f32)
  (fn [pos] (- (length pos) radius)))

(defn box [size: vec3f]: (Fn [vec3f] f32)
  (fn [pos]
    (let [q (- (abs pos) size)]
      (+ (length (max q (vec3f 0.)))
         (min (max q.x (max q.y q.z)) 0.)))))

(var out: [2: f32])

@cpu
(defn main []
  (let [shapes ~[(Shape (sphere 0.5) 2.) (Shape (box (vec3f 1.)) 3.)]]
    (dispatch-compute-shader
      (fn []
        (for [i (array-length shapes)]
          (let [shape (shapes i)]
            (= (out i) (* shape.scale (shape.sdf (vec3f 3. 0. 0.)))))))
      (vec3u 1u))
    (print out)))
