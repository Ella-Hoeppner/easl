; A FIXED-size array of dyn arrays, copied whole across call boundaries.
; Fixed arrays are slot-resident (`vm_stack_size` recurses per element,
; so `[2: [f32]]` is two id words — VM sizing, not the flat GPU layout,
; which can't size heap elements), and whole-array copies go through
; `emit_value_copy`, whose fixup walker recurses literal-count elements
; and promotes each id to an owned share. Guards that the container
; soundness hole is specific to heap-backed (runtime-sized) containers.
(defn build [v: f32]: [2: [f32]]
  [(into-dynamic-array [v v]) (into-dynamic-array [v])])

@cpu
(defn main []
  (let [a (build 1.)
        b (build 9.)]
    (print ((a 0u) 0u))
    (print (array-length (a 1u)))
    (print ((b 0u) 0u))))
