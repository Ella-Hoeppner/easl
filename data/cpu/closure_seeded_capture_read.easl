; A closure over a seeded runtime-sized array and a mutated index
; variable, called repeatedly: the pre-capture element write must be
; visible through the capture, and the index mutation must persist across
; calls (reads walk indices 1, 2, 3, 0 — the last hitting the seeded
; 10.). Pins two things: the call-site view invariant — when
; `inline_local_bound_function_applications` rewrites a direct closure
; call to `(inner_fn c)`, the callee's own function-type view must gain
; the scope param alongside the appended arg (its LocalBinding arm once
; skipped this, leaving a zero-arg view whose empty ownership bookkeeping
; silently dropped the captured scope's write-back, freezing the
; closure's state, and leaked the scope binding each call) — and the
; tree-walker's defense: per-param ownerships come from the
; implementation's own function type, the source the VM's ref-arg
; detection uses, so a stale view can't repeat the damage.
(defn make-reader [n: u32
                   v: f32]: (Fn [] f32)
  (let [@var buf (zeroed-array n): [f32]
        @var idx 0u]
    (= (buf 0u) v)
    (fn []
        (= idx (% (+ idx 1u) n))
        (buf idx))))

@cpu
(defn main []
  (let [c (make-reader 4u 10.)]
    (print (c))
    (print (c))
    (print (c))
    (print (c))))
