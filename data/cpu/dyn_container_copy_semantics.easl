; Value semantics across a copy of a container with heap-embedding
; elements. Copying the container is an `Arc` share; the first element
; store through `a` hits the emitted ensure-unique sequence
; (`emit_ensure_unique_cell` — the compile-time-emitted replacement for
; `Arc::make_mut`'s layout-blind word clone): a fresh uniquely-owned
; cell is built with re-owned element ids, so `b` keeps the original
; cell and its own payloads through both the store and `pair-of`'s
; re-execution.
(struct Packet
  tag: f32
  body: [f32])

(defn pair-of [t: f32]: [Packet]
  (into-dynamic-array [(Packet t (into-dynamic-array [t]))]))

@cpu
(defn main []
  (let [@var a (pair-of 1.)
        b a]
    (= (a 0u) (Packet 2. (into-dynamic-array [2.])))
    (let [other (pair-of 9.)]
      (let [pa (a 0u)
            pb (b 0u)
            po (other 0u)]
        (print pa.tag)
        (print (pa.body 0u))
        (print pb.tag)
        (print (pb.body 0u))
        (print po.tag)
        (print (po.body 0u))))))
