; Storage-space vars passed as references in CPU code — the ring-buffer
; pattern from adsr_demo: generic `@ref`/`@var @ref` helpers reading and
; mutating a storage-write dyn global and its u32 cursor. The reference
; monomorphizer inlines the specific global in place of each whole-global
; ref parameter (per-(function, global) variants), so the helpers' bodies
; access `history`/`cursor` directly on both runtimes. The same calls
; work in GPU-reachable code too — pinned by the `storage_ref_gpu` shader
; test; only accessor-chain refs into these spaces stay CPU/audio-only
; (`user_reference_failure_uniform` pins that side).
(defn (get-ring T)
      [@ref buffer: [T]
       start: u32
       index: u32]: T
  (-> index
      (+ start)
      (% (length buffer))
      buffer))

(defn (push-ring T)
      [@var @ref buffer: [T]
       @var @ref start: u32
       value: T]
  (= (buffer start) value)
  (= start (% (+ start 1u) (length buffer))))

(var history: [f32])

(var cursor: u32)

@cpu
(defn main []
  (= history (zeroed-array 3))
  (push-ring history cursor 1.)
  (push-ring history cursor 2.)
  (push-ring history cursor 3.)
  (push-ring history cursor 4.)
  (print cursor)
  (print (get-ring history cursor 0u))
  (print (get-ring history cursor 1u))
  (print (get-ring history cursor 2u)))
