; Element stores into a runtime-sized array of heap-payload enums
; (`emit_embedding_element_store`): the old element's embedded ids are
; released (loaded to scratch — releasing by id value releases the
; container's ids), the new value is staged with fresh owned shares,
; word-copied in, and the stage's id words zeroed (ownership moved into
; the container). Each loop iteration's payload then survives the next
; iteration's construction-site release. The `[String]`/`[[f32]]`
; `Cells` containers handle the same pattern via Arc children.
(enum (Option T)
  None
  (Some T))

(defn empty-pair []: [(Option [f32])]
  (zeroed-array 2u))

@cpu
(defn main []
  (let [@var xs (empty-pair)]
    (for [i 0u (< i 2u) (+= i 1u)]
      (= (xs i) (Some (into-dynamic-array [(f32 i) (f32 i)]))))
    (match (xs 0u)
      (Some arr) (print (arr 0u))
      None (print 99.))
    (match (xs 1u)
      (Some arr) (print (arr 0u))
      None (print 99.))))
