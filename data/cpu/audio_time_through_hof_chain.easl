; An anonymous closure calling `audio-time` handed to `start-audio`
; through TWO higher-order wrappers. The closure genuinely runs on the
; audio thread, so this compiles: the context-exclusivity pass follows
; call edges to decide where code runs, so wrapper depth is irrelevant
; (the old cut-based `validate_audio_info_usage` walk spuriously
; rejected exactly this shape).
(defn attenuate [s: (Fn [] f32)
                 k: f32]: (Fn [] f32)
  (fn [] (* k (s))))

@cpu
(defn main []
  (start-audio (-> (fn [] (sin (audio-time)))
                   (attenuate 0.5)
                   (attenuate 0.25)))
  (spawn-window (fn [] ())))
