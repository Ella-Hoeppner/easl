; Runtime-index element stores into a FIXED-size array of structs
; carrying a runtime-sized field: the embedded body id sits at a static
; offset within the write-back temp, where `emit_value_copy`'s fixups
; handle it; `ArrayStore` then word-copies the whole element to
; `base + i*stride` (see fixed_array_dyn_element_store for why the
; composition is sound).
(struct Packet
  tag: f32
  body: [f32])

(defn empty-pair []: [2: Packet]
  [(Packet 0. (into-dynamic-array [0.]))
   (Packet 0. (into-dynamic-array [0.]))])

@cpu
(defn main []
  (let [@var xs (empty-pair)]
    (for [i 0u (< i 2u) (+= i 1u)]
      (= (xs i) (Packet (f32 i) (into-dynamic-array [(f32 i) (f32 i)]))))
    (let [p (xs 0u)
          q (xs 1u)]
      (print p.tag)
      (print (p.body 0u))
      (print q.tag)
      (print (q.body 0u)))))
