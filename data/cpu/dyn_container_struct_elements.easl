; A runtime-sized array of structs carrying a runtime-sized field —
; the flat-words container path with static (non-discriminant) fixup
; offsets: construction re-owns each element's `body` id, so `a`'s
; element keeps both its flat `tag` and its heap `body` after `build`
; re-executes.
(struct Packet
  tag: f32
  body: [f32])

(defn build [v: f32]: [Packet]
  (into-dynamic-array [(Packet v (into-dynamic-array [v v v]))]))

@cpu
(defn main []
  (let [a (build 1.)
        b (build 9.)]
    (let [p (a 0u)]
      (print p.tag)
      (print (p.body 0u)))
    (let [q (b 0u)]
      (print q.tag)
      (print (q.body 0u)))))
