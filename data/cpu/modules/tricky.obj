# A unit square in the z=0 plane, as a quad, then a triangle above it.
# Comments, blank lines, and things this reader skips are mixed in.
mtllib tricky.mtl
o square

v -1 -1 0
v  1.0 -1 0.0
v  1 1e0 0
v  -1.0e+0   1.5E-1  .0
vt 0.5 0.5
vn 0 0 1
usemtl plain
f 1/1/1 2/1/1 3/1/1 4/1/1

	v 0 0 2.5
v 1 0 2
v 0 1 2   
f -3 -2//1 -1/1
