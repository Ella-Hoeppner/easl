; A small Wavefront OBJ reader, written with the string builtins: it keeps
; `v` positions and `f` faces, fanning polygons into triangles, and gives
; every vertex a smooth normal. Other lines are skipped. A face's corners can
; be `1`, `1/2`, `1/2/3`, or `1//3` (only the position index is used), and
; negative indices count back from the latest vertex.

(struct Mesh
  positions: [vec3f]
  normals: [vec3f]
  indices: [u32])

; A vertex for drawing, with `mesh-vertices`.
(struct Vertex
  position: vec3f
  normal: vec3f)

(defn char-at [@ref text: String at: u32]: String
  (substr text at (+ at 1u)))

(defn digit-value [c: String]: i32
  (if (== c "0") 0i
    (if (== c "1") 1i
      (if (== c "2") 2i
        (if (== c "3") 3i
          (if (== c "4") 4i
            (if (== c "5") 5i
              (if (== c "6") 6i
                (if (== c "7") 7i
                  (if (== c "8") 8i
                    (if (== c "9") 9i -1i))))))))))) 

(defn space? [c: String]: bool
  (|| (== c " ") (== c "\t")))

; The end of a line, or of the text (where `char-at` gives "").
(defn line-end? [c: String]: bool
  (|| (== c "\n") (|| (== c "\r") (== c ""))))

(defn skip-spaces [@ref text: String @var @ref at: u32]
  (while (space? (char-at text at))
    (+= at 1u)))

(defn skip-line [@ref text: String @var @ref at: u32]
  (while (&& (< at (length text)) (!= (char-at text at) "\n"))
    (+= at 1u))
  (+= at 1u))

; Reads optional `-`/`+`, returning the sign.
(defn read-sign [@ref text: String @var @ref at: u32]: f32
  (let [c (char-at text at)]
    (when (|| (== c "-") (== c "+"))
      (+= at 1u))
    (if (== c "-") -1. 1.)))

(defn read-digits [@ref text: String @var @ref at: u32]: f32
  (let [@var value 0.
        @var digit (digit-value (char-at text at))]
    (while (>= digit 0i)
      (= value (+ (* value 10.) (f32 digit)))
      (+= at 1u)
      (= digit (digit-value (char-at text at))))
    value))

; Reads a number like `12`, `-0.5`, `.25`, or `1.5e-3`.
(defn read-f32 [@ref text: String @var @ref at: u32]: f32
  (skip-spaces text at)
  (let [polarity (read-sign text at)
        @var value (read-digits text at)]
    (when (== (char-at text at) ".")
      (+= at 1u)
      (let [start at
            fraction (read-digits text at)]
        (+= value (/ fraction (pow 10. (f32 (- at start)))))))
    (let [c (char-at text at)]
      (when (|| (== c "e") (== c "E"))
        (+= at 1u)
        (let [exponent-sign (read-sign text at)
              exponent (read-digits text at)]
          (*= value (pow 10. (* exponent-sign exponent))))))
    (* polarity value)))

; Reads a face corner, skipping anything after its position index, and gives
; the position's index into a mesh of `count` positions.
(defn read-corner [@ref text: String @var @ref at: u32 count: u32]: u32
  (let [polarity (read-sign text at)
        index (u32 (read-digits text at))]
    (while (let [c (char-at text at)]
             (! (|| (space? c) (line-end? c))))
      (+= at 1u))
    (if (< polarity 0.)
      (- count index)
      (- index 1u))))

; Whether a face line has another corner at `at`, moving past any spaces.
(defn more-corners? [@ref text: String @var @ref at: u32]: bool
  (skip-spaces text at)
  (! (line-end? (char-at text at))))

; The area-weighted normals of `indices`' triangles, summed at each vertex.
(defn smooth-normals [positions: [vec3f] indices: [u32]]: [vec3f]
  (let [@var normals: [vec3f] (zeroed-array (array-length positions))]
    (for [i 0u (< i (array-length indices)) (+= i 3u)]
      (let [a (indices i)
            b (indices (+ i 1u))
            c (indices (+ i 2u))
            normal (cross (- (positions b) (positions a))
                          (- (positions c) (positions a)))]
        (+= (normals a) normal)
        (+= (normals b) normal)
        (+= (normals c) normal)))
    (for [i 0u (< i (array-length normals)) (+= i 1u)]
      (when (> (length (normals i)) 0.)
        (= (normals i) (normalize (normals i)))))
    normals))

(defn parse-obj [text: String]: Mesh
  (let [@var positions: [vec3f] (zeroed-array 0u)
        @var indices: [u32] (zeroed-array 0u)
        @var at 0u]
    (while (< at (length text))
      (skip-spaces text at)
      (let [keyword (char-at text at)
            next (char-at text (+ at 1u))]
        (if (&& (== keyword "v") (space? next))
          (do (+= at 1u)
              (let [x (read-f32 text at)
                    y (read-f32 text at)
                    z (read-f32 text at)]
                (= positions (push positions (vec3f x y z)))))
          (when (&& (== keyword "f") (space? next))
            (+= at 1u)
            (skip-spaces text at)
            (let [count (array-length positions)
                  first (read-corner text at count)
                  @var previous first]
              (skip-spaces text at)
              (= previous (read-corner text at count))
              (while (more-corners? text at)
                (let [corner (read-corner text at count)]
                  (= indices (push indices first))
                  (= indices (push indices previous))
                  (= indices (push indices corner))
                  (= previous corner))))))
        (skip-line text at)))
    (Mesh positions (smooth-normals positions indices) indices)))

(defn mesh-vertices [mesh: Mesh]: [Vertex]
  (let [@var vertices: [Vertex]
             (zeroed-array (array-length mesh.positions))]
    (for [i 0u (< i (array-length vertices)) (+= i 1u)]
      (= (vertices i) (Vertex (mesh.positions i) (mesh.normals i))))
    vertices))
