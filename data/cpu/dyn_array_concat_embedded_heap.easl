; concat on a container whose flat element words embed heap ids without
; being one (enum with a dyn-array payload): the new cell's borrowed
; element ids get owned shares via the re-own loop, and both sources stay
; independent (COW).
(enum (Option T)
  (Some T)
  None)

(defn (print-opt-arrs) [arrs: [(Option [f32])]]
  (for [i (array-length arrs)]
    (match (arrs i)
      (Some inner) (print inner)
      None (print "none"))))

@cpu
(defn main []
  (let [a ~[(Some ~[1. 2.]) None]: [(Option [f32])]
        b ~[(Some ~[3.])]: [(Option [f32])]
        c (concat a b)]
    (print-opt-arrs c)
    (print "--")
    (print-opt-arrs a)))
