; `==` and `!=` on enums compare the variant, then (for the same variant)
; the payloads with their own `==`: scalars, bools, vectors (every
; component), and nested enums.
(enum Light
  Red
  Yellow
  Green)

(enum Shape
  Empty
  (Circle f32)
  (Point vec2f)
  (Flag bool)
  (Tinted Light))

(defn (same? T) [a: (Option T) b: (Option T)]: bool
  (== a b))

@cpu
(defn main []
  (let [e Light/Red]
    (print (== e Light/Red))
    (print (== e Light/Yellow))
    (print (!= e Light/Yellow)))
  (print (== (Shape/Circle 1.) (Shape/Circle 1.)))
  (print (== (Shape/Circle 1.) (Shape/Circle 2.)))
  ; the payloads' own `==`: 0. and -0. are equal
  (print (== (Shape/Circle 0.) (Shape/Circle -0.)))
  (print (== (Shape/Circle 1.) Shape/Empty))
  (print (== Shape/Empty Shape/Empty))
  (print (== (Shape/Point (vec2f 1. 2.)) (Shape/Point (vec2f 1. 2.))))
  (print (== (Shape/Point (vec2f 1. 2.)) (Shape/Point (vec2f 1. 3.))))
  (print (!= (Shape/Point (vec2f 1. 2.)) (Shape/Point (vec2f 1. 3.))))
  (print (== (Shape/Flag true) (Shape/Flag false)))
  (print (== (Shape/Tinted Light/Red) (Shape/Tinted Light/Red)))
  (print (== (Shape/Tinted Light/Red) (Shape/Tinted Light/Green)))
  (print (== (Some 3u) (Some 3u)))
  (print (== (Some 3u) None))
  (print (same? (Some 1.) (Some 1.)))
  (print (same? (Some Light/Red) (Some Light/Yellow))))
