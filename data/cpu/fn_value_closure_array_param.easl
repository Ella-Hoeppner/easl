; An array of stateful closures passed to an `@var @ref` parameter is lent:
; the callee's calls advance the caller's closures in place.
(defn make-counter [inc: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n inc)
      n)))
(defn step-bank [@var @ref oscs: [2: (Fn [] f32)]]: f32
  (+ ((oscs 0u)) ((oscs 1u))))
@cpu
(defn main []
  (let [@var bank [(make-counter 1.) (make-counter 10.)]]
    (print (step-bank bank))
    (print (step-bank bank))
    (print (step-bank bank))))
