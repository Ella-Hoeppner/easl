; Overloads distinguished ONLY by a function-typed param's return type:
; candidate filtering compares function types through
; `FunctionSignature::compatible`, whose return-type comparison is what
; discriminates these (a return-blind comparison left both candidates
; in the `OneOf` forever — `CouldntInferTypes` even with fully
; decidable arguments). Pins all three call shapes that were broken:
; a direct lambda argument, an unannotated let-bound closure, and an
; explicitly ascribed lambda.
(struct Params
  cutoff: f32
  q: f32)

(defn describe [g: (Fn [] f32)]: f32
  (g))

(defn describe [g: (Fn [] Params)]: f32
  (let [p (g)]
    (+ p.cutoff p.q)))

@cpu
(defn main []
  (print (describe (fn [] 7.)))
  (print (describe (fn [] (Params 5. 3.))))
  (let [gen (fn [] (Params 10. 4.))]
    (print (describe gen)))
  (print (describe (fn [] 9.): (Fn [] f32))))
