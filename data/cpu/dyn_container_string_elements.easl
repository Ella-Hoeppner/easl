; A runtime-sized array of structs carrying a String field — Strings
; are heap values like dyn arrays, so the embedding-element machinery
; covers them with the same fixup offsets; each element's name survives
; the second `build` call.
(struct Named
  id: f32
  name: String)

(defn build [id: f32 name: String]: [Named]
  (into-dynamic-array [(Named id name)]))

@cpu
(defn main []
  (let [a (build 1. "one")
        b (build 2. "two")]
    (let [n (a 0u)]
      (print n.id)
      (print n.name))
    (let [m (b 0u)]
      (print m.id)
      (print m.name))))
