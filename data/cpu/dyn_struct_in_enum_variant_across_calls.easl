; KNOWN-FAILING (bytecode VM): a struct carrying a runtime-sized field
; nested inside one enum variant — the variant's fixups must recurse into
; the payload struct's layout (discriminant at 0, tag at 1, body id at
; 2), exercising nontrivial fixup offsets *within* a variant branch.
; Today `a`'s embedded body id borrows the constructor's site and aliases
; `b`'s buffer after the second call.
(struct Packet
  tag: f32
  body: [f32])

(enum Message
  (Data Packet)
  Quiet)

(defn make [n: u32]: Message
  (Data (Packet (f32 n) (zeroed-array n))))

@cpu
(defn main []
  (let [a (make 3u)
        b (make 2u)]
    (match a
      (Data p) (print (array-length p.body))
      Quiet (print 0u))
    (match b
      (Data p) (print (array-length p.body))
      Quiet (print 0u))))
