; A global whose type is a runtime-sized array of heap-payload enums.
; Whole-global assignment (`RegionFromHeap`) releases the region's old
; element ids, clones the cell's words, and re-owns the fresh region
; words (`emit_release/reown_container_elements` around the op) — the
; region owns its elements' ids, so the builder's later releases can't
; dangle them.
(enum (Option T)
  None
  (Some T))

@local
(var g: [(Option [f32])])

(defn build [v: f32]: [(Option [f32])]
  (into-dynamic-array [(Some (into-dynamic-array [v v]))]))

@cpu
(defn main []
  (= g (build 1.))
  (let [other (build 9.)]
    (match (g 0u)
      (Some arr) (print (arr 0u))
      None (print 99.))
    (match (other 0u)
      (Some arr) (print (arr 0u))
      None (print 99.))))
