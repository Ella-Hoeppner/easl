; Matching an immutable `let` binding: calling the payload closure still
; advances it in place, as calling a `let`-bound closure does.
(defn make-counter [inc: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n inc)
      n)))

(defn make-doubler [start: f32]: (Fn [] f32)
  (let [@var v start]
    (fn []
      (*= v 2.)
      v)))

(enum Voice
  (Playing (Fn [] f32))
  Silent)

(defn step [@var @ref v: Voice]: f32
  (match v
    (Playing f) (f)
    Silent 0.))
@cpu
(defn main []
  (let [v (Playing (make-counter 1.))]
    (match v
      (Playing f) (print (f))
      Silent ())
    (match v
      (Playing f) (print (f))
      Silent ())))
