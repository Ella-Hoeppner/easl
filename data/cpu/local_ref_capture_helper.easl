; A local closure capturing a bare `@ref` param as a convenience helper
; (Ella's sum-of-even-elements sketch) — legal and well-defined: within
; the call nothing can mutate the referent, so the capture's snapshot is
; indistinguishable from a live reference. Only *escaping* ref-capturing
; closures are rejected (`EscapingClosureCapturesRefArg`).
(defn sum-of-all-even-elements [@ref arr: [f32]]: f32
  (let [nth-even-element (fn [i: u32] (arr (* i 2u)))
        @var sum 0.]
    (for [i (/ (array-length arr) 2u)]
      (+= sum (nth-even-element i)))
    sum))

@cpu
(defn main []
  (let [data (into-dynamic-array [1. 10. 2. 20. 3. 30.])]
    (print (sum-of-all-even-elements data))))
