; Generics used only in "indirect" positions must NOT be flagged as
; unused: `T` appears only inside a (Fn ...) argument, `U` only in the
; return type, `C` only as a const-generic array size, and `V` only in
; an enum payload argument.
(defn (mapper T U)
      [f: (Fn [T] U)
       x: T]: U
      (f x))

(defn (make-zeros C: u32) []: [C: f32]
  (zeroed-array))

(enum (Box V) (Full V) Empty)

(defn (unbox V) [b: (Box V) fallback: V]: V
  (match b (Full v) v Empty fallback))

@cpu
(defn main []
  (print (mapper (fn [x] (> x 0.5)) 1.))
  (print (make-zeros): [3: f32])
  (print (unbox (Full 7.) 0.))
  (print (unbox Empty: (Box f32) 9.)))
