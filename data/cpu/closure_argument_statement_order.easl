; A closure built as an argument to a higher-order function, whose scope is
; computed from a value earlier statements changed: the scope is built
; where the argument is, after those statements (and afresh in each loop
; iteration or `match` arm), never hoisted above them.
(defn + [a: (Fn [] f32)
         b: (Fn [] f32)]: (Fn [] f32)
  (fn [] (+ (a) (b))))

(defn sizer [xs: [f32]]: (Fn [] f32)
  (let [n (f32 (array-length xs))]
    (fn [] n)))

(defn call [f: (Fn [] f32)]: f32
  (f))

@cpu
(defn main []
  (let [@var xs ~[]: [f32]]
    (= xs (push xs 1.))
    (= xs (push xs 2.))
    (print (call (+ (fn [] 0.) (sizer xs)))))
  (let [@var ys ~[]: [f32]]
    (for [i 3u]
      (= ys (push ys 1.))
      (print (call (+ (fn [] 0.) (sizer ys))))))
  (let [@var zs ~[]: [f32]]
    (match true
      true (do (= zs (push zs 1.))
               (print (call (+ (fn [] 0.) (sizer zs)))))
      false ())))
