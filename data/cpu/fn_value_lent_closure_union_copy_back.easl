; A closure lent to a stored call whose parameter's set is a union (the
; callee stashes it in a global alongside another closure kind): it's copied
; into the union for the call and its state copied back afterwards. Each
; closure is lent once and then only reached through the global, so no
; stateful closure is ever used from two places.
(defn make-counter [amount: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n amount)
      n)))
(defn make-doubler [start: f32]: (Fn [] f32)
  (let [@var v start]
    (fn []
      (*= v 2.)
      v)))
(defn zero []: f32 0.)

@local
(var last: (Fn [] f32) zero)

(defn remember [g: (Fn [] f32)]: f32
  (= last g)
  0.)
(defn plain [g: (Fn [] f32)]: f32
  (g))

@cpu
(defn main []
  (let [hs [remember plain]]
    (print ((hs 0u) (make-counter 1.)))
    (print (last))
    (print (last))
    (let [d (make-doubler 1.)]
      (print ((hs 0u) d)))
    (print (last))
    (print ((hs 1u) (make-counter 10.)))))
