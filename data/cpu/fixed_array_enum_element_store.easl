; Runtime-index element stores into a FIXED-size array of heap-payload
; enums. The store's temp copy is a full enum-dispatch `emit_value_copy`
; — the release side dispatches on the preloaded OLD element's
; discriminant, the promote side on the new one's — composed with the
; `ArrayLookup`/`ArrayStore` write-back (see
; fixed_array_dyn_element_store). Guards the dispatch machinery through
; the indexed-store path.
(enum (Option T)
  None
  (Some T))

(defn empty-pair []: [2: (Option [f32])]
  [None None])

@cpu
(defn main []
  (let [@var xs (empty-pair)]
    (for [i 0u (< i 2u) (+= i 1u)]
      (= (xs i) (Some (into-dynamic-array [(f32 i)]))))
    (match (xs 0u)
      (Some arr) (print (arr 0u))
      None (print 99.))
    (match (xs 1u)
      (Some arr) (print (arr 0u))
      None (print 99.))))
