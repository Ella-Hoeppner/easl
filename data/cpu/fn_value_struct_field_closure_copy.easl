; A stateful closure in a struct field advances in place when called through
; the field, and when the struct is lent to an `@var @ref` parameter.
(defn make-counter [inc: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n inc)
      n)))
(struct Holder f: (Fn [] f32))
(defn use-holder [@var @ref h: Holder]: f32 (h.f))
@cpu
(defn main []
  (let [@var h (Holder (make-counter 1.))]
    (print (use-holder h))
    (print (use-holder h))
    (print (h.f))
    (print (h.f))))
