; Binding a stateful closure to a new name copies it: the copy starts from the
; original's state at the moment of binding, and afterwards the two advance
; independently (value semantics, like every other easl value).
(defn make-counter [inc: f32]: (Fn [] f32)
  (let [@var n 0.]
    (fn []
      (+= n inc)
      n)))

@cpu
(defn main []
  ; copied before either is called
  (let [f (make-counter 1.)
        g f]
    (print (f))
    (print (f))
    (print (g))
    (print (f)))
  ; copied after the original has advanced
  (let [f (make-counter 10.)]
    (print (f))
    (let [g f]
      (print (g))
      (print (g))
      (print (f)))))
