; Whole-enum copies of heap payloads (bytecode VM). Enum *construction*
; promotes its payload's heap id (the variant is known statically); a
; whole-enum value crossing a call boundary is copied with the bulk Move
; plus a discriminant-keyed fixup dispatch — the payload offsets depend
; on the runtime discriminant, so `emit_heap_fixups` emits a
; compare-and-skip branch per heap-bearing variant. Without the dispatch,
; the caller's payload id stays a borrow of the callee's enum region,
; which the second `make` call frees and reuses — `a`'s payload would
; alias `b`'s shorter array.
(enum (Option T)
  (Some T)
  None)

(defn make [n: u32]: (Option [f32])
  (Some (zeroed-array n)))

@cpu
(defn main []
  (let [a (make 4u)
        b (make 2u)]
    (match a
      (Some arr) (print (array-length arr))
      None (print 0u))
    (match b
      (Some arr) (print (array-length arr))
      None (print 0u))))
