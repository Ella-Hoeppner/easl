; Runtime-index element stores into a FIXED-size array of dyn arrays.
; Sound by composition: the assignment LHS compiles in ref-arg position,
; so `ArrayLookup` preloads the OLD element into the site's static temp,
; `emit_value_copy` RHS→temp releases it and owns the new id, and the
; pending `ArrayStore` word-copies the id back into `base + i*stride`.
; The array slot's word is nominally a borrow, but the element cell
; stays alive through the heap table and is released exactly once by
; the next store's preload — the same one-live-cell-per-site reclamation
; as every other v1 site. (Contrast `dyn_container_element_store`: the
; heap-backed container path lacks this preload/release composition.)
@cpu
(defn main []
  (let [@var xs [(into-dynamic-array [9.]) (into-dynamic-array [9.])]]
    (for [i 0u (< i 2u) (+= i 1u)]
      (= (xs i) (into-dynamic-array [(f32 i) (f32 i)])))
    (print ((xs 0u) 0u))
    (print ((xs 1u) 0u))))
