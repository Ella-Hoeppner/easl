; KNOWN-FAILING (bytecode VM): variant transitions under whole-enum
; assignment. `(= y x)` overwriting a None with a Some must promote the
; copied payload id to an owned share (release side: none — the dest's
; old discriminant has no payload); `(= x None)` overwriting a Some must
; release the dest's old payload while y's share survives. Today both
; are plain Moves: y's id stays a borrow of `boxed`'s construction site,
; which the second `boxed` call frees and reuses, so y silently reads
; the fresh [9. 9. 9.] instead of its own [1. 1. 1.].
(enum (Option T)
  (Some T)
  None)

(defn boxed [v: f32]: (Option [f32])
  (Some (into-dynamic-array [v v v])))

@cpu
(defn main []
  (let [@var x (boxed 1.)
        @var y: (Option [f32]) None]
    (= y x)
    (= x None)
    (= x (boxed 9.))
    (match y
      (Some arr) (print (arr 0u))
      None (print 0u))
    (match x
      (Some arr) (print (arr 0u))
      None (print 0u))))
