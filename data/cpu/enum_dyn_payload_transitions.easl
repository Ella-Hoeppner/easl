; Variant transitions under whole-enum assignment (bytecode VM). `(= y
; x)` overwriting a None with a Some must promote the copied payload id
; to an owned share (release side: none — the dest's old discriminant
; has no payload); `(= x None)` overwriting a Some must release the
; dest's old payload while y's share survives. This is why the copy
; dispatch reads the *destination's* discriminant before the Move (old
; variant's releases) and again after it (new variant's promotes) — the
; two variants differ exactly here. Without it, y's id would stay a
; borrow of `boxed`'s construction site, freed and reused by the second
; `boxed` call.
(enum (Option T)
  (Some T)
  None)

(defn boxed [v: f32]: (Option [f32])
  (Some (into-dynamic-array [v v v])))

@cpu
(defn main []
  (let [@var x (boxed 1.)
        @var y: (Option [f32]) None]
    (= y x)
    (= x None)
    (= x (boxed 9.))
    (match y
      (Some arr) (print (arr 0u))
      None (print 0u))
    (match x
      (Some arr) (print (arr 0u))
      None (print 0u))))
