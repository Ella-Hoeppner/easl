; A for loop whose continue-condition gets statement-lifted by
; deexpressionification (the bound is `length` of a let-bound dyn array,
; whose owned-arg copy hoists a let into the condition): the lifted
; check must run BEFORE the body on every iteration including the
; first. The extraction pass previously rotated these loops into
; do-whiles — body first, check appended last — so a zero-length loop
; ran its body once and indexed out of bounds (the shape real MIDI
; programs hit whenever `down-midi-notes` is empty).
(var xs: [f32])

@cpu
(defn main []
  (let [notes xs]
    (for [i (length notes)]
      (print (notes i))))
  (= xs (into-dynamic-array [7. 8.]))
  (let [notes xs]
    (for [i (length notes)]
      (print (notes i))))
  (print 999u))
