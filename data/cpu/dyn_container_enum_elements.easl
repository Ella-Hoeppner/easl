; A runtime-sized array whose elements are heap-payload enums. The
; container stores flat words (`DynMemory::Words`), and construction
; (`HeapFromSlots`) clones the source slots' words — so the emitted
; re-own pass (`emit_reown_container_elements`) walks the fresh cell
; giving each element's payload id an owned share, with the per-variant
; discriminant dispatch selecting which offsets hold ids. The second
; `build` call's slot releases then can't touch `a`'s payloads.
(enum (Option T)
  None
  (Some T))

(defn build [v: f32]: [(Option [f32])]
  (into-dynamic-array [(Some (into-dynamic-array [v v]))
                       None]))

@cpu
(defn main []
  (let [a (build 1.)
        b (build 9.)]
    (match (a 0u)
      (Some arr) (print (arr 0u))
      None (print 99.))
    (match (b 0u)
      (Some arr) (print (arr 0u))
      None (print 99.))))
