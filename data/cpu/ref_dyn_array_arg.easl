; A runtime-sized array passed as a `@ref` argument, read and mutated
; through the ref. Pins the VM's ref-arg call-boundary handling: only
; *owned* args get placeholder copy instructions at the call site (a
; placeholder emitted for a ref arg would go unpatched by per-usage
; resolution and execute as a garbage copy — for a heap-typed arg, a
; `HeapCopy` dereferencing slot 0 as a heap id). The ref param binds
; directly to the caller's heap-id slot, so mutation through it is
; visible to the caller.
(defn second-el [@ref arr: [f32]]: f32
  (arr 1u))

(defn bump-first [@var @ref arr: [f32]]
  (= (arr 0u) (+ (arr 0u) 10.)))

@cpu
(defn main []
  (let [@var xs (into-dynamic-array [1. 2. 3.])]
    (print (second-el xs))
    (bump-first xs)
    (print (xs 0u))))
