; Used by the hand-written `start_audio_bootstrap_publishes_current_globals`
; test: an audio entry reading both a slot-backed global and a runtime-sized
; array, both also written by the main entry — which is what makes them
; thread-shared, so the `start-audio` bootstrap publish carries the main
; side's current values into the audio replica.

@local
(var sample: [f32])

@local
(var gain: f32 0.5)

@audio
(defn f [t: f32 rate: f32]: f32
  (* gain (sample 2u)))

@cpu
(defn main []
  (= sample (into-dynamic-array [1. 2. 3. 4.]))
  (= gain 0.75))
