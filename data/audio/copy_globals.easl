; Used by the hand-written `start_audio_copies_current_globals` test: an
; audio entry reading both a slot-backed global and a runtime-sized array,
; whose values are populated on the main side and snapshotted into the
; audio program.

(var sample: [f32])

(var gain: f32 0.5)

@audio
(defn f [t: f32 rate: f32]: f32
  (* gain (sample 2u)))

@cpu
(defn main [] ())
