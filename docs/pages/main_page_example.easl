(def TAU: f32
     6.28318530718)

@vertex
(defn vert []: vec4f
  (vec4f (match (vertex-index)
           0 (vec2f -1.)
           1 (vec2f -1. 3.)
           _ (vec2f 3. -1.))
         0.
         1.))

(defn palette [t: f32]: vec3f
  (+ (vec3f 0.2 0.9 0.4)
     (* (vec3f 0.42 0.1 0.34)
        (cos (* TAU
                (+ (vec3f t) (vec3f 0. 0.3 0.15)))))))

@fragment
(defn frag []: vec4f
  (let [res (vec2f (window-resolution))
        t (* 0.12 (window-time))
        uv0 (- (/ (- (* 2. (.xy (position))) res)
                  (vec2f res.y))
               (vec2f 0.45 0.06))
        @var uv uv0
        @var col (vec3f 0.)]
    (for [i 4u]
      (= uv
         (- (fract (* uv 1.5))
            (vec2f 0.5)))
      (let [d0 (* (length uv)
                  (exp (- (length uv0))))
            c (palette (+ (length uv0)
                          (* 0.35 (f32 i))
                          t))
            d1 (/ (sin (+ (* 8. d0) (* 4. t)))
                  8.)
            glow (pow (/ 0.006 (abs d1)) 1.25)]
        (= col
           (+ col (* c (vec3f glow))))))
    (vec4f (* col (vec3f 0.6)) 1.)))

@cpu
(defn main []
  (spawn-window (fn []
                  (dispatch-render-shaders vert frag 3))))
